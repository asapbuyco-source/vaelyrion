# Server
PORT=3001

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public site URLs (SEO canonical, payment redirects, CORS allow-list)
SITE_URL="https://www.tanelia.shop"
FRONTEND_URL="https://www.tanelia.shop"
# Optional override for the webhook-visible API origin (defaults to SITE_URL)
API_URL="https://www.tanelia.shop"

# Stripe (card payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cryptomus (hosted card & crypto payments)
# Merchant UUID and Payment API key from the Cryptomus merchant dashboard.
CRYPTOMUS_MERCHANT_ID="your-merchant-uuid"
CRYPTOMUS_PAYMENT_API_KEY="your-payment-api-key"
# Set to "false" to hide the Cryptomus option in checkout.
VITE_CRYPTOMUS_ENABLED="true"

# Resend (transactional email engine)
RESEND_API_KEY="re_..."
EMAIL_FROM="Tanelia <orders@tanelia.shop>"
EMAIL_REPLY_TO="support@tanelia.shop"
ADMIN_EMAIL="taneliashop17@gmail.com"
SUPPORT_EMAIL="taneliashop17@gmail.com"

# Editorial AI drafting (server-side only — never expose to Vite/client code)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="openai/gpt-4o-mini"
CRON_SECRET="replace-with-a-long-random-secret"
